# Defensa en profundidad: aunque este directorio ya está fuera del docroot
# público (public/) en un despliegue estándar de Laravel, este .htaccess
# bloquea el acceso directo si el hosting sirve el proyecto completo en vez
# de solo public/.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
